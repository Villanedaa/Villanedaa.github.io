rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CAMBIE los correos por los de las personas que pueden usar el sistema
    function permitido() {
      return request.auth != null
        && request.auth.token.email in ['sebastianvillaneda202@gmail.com', 'otro@correo.com','milerick08@gmail.com'];
    }

    match /operaciones/{id} { allow read, write: if permitido(); }
    match /ventas/{id}      { allow read, write: if permitido(); }
    match /prestamos/{id}   { allow read, write: if permitido(); }
  }
}
